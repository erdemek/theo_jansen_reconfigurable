      </body>

      <body name="triangle_link1_r" pos="0.11404 -0.05 0" euler="0 -22 0" childclass="leg_contact">
        <joint name="tri_hinge_r" type="hinge" pos="0 0 0"/>

        <geom name="edge_b_r" type="capsule" fromto="0 0 0 0 0 0.06328" rgba="0 1 0 1"/>
        <geom name="edge_e_r" type="capsule" fromto="0 0 0.06328 0.0600779625 0 -0.0019622756" rgba="0 1 0 1"/>
        <geom name="edge_d_r" type="capsule" fromto="0.0600779625 0 -0.0019622756 0 0 0" rgba="0 1 0 1"/>

        <body name="link_f_r" pos="0.0600779625 0 -0.0019622756" euler="0 135 0">
          <joint name="hinge_f_r" type="hinge" pos="0 0 0"/>
          <geom name="link_f_r_outer" type="capsule" fromto="0 0 0 0.02836 0 0" rgba="0 1 0 1"/>
          <body name="link_f_r_inner" pos="0.02836 0 0">
            <joint name="slide_f_r" type="slide" axis="1 0 0" limited="true" range="-0.005 0.005" damping="100" armature="0.1"
                   solreflimit="0.00001 1" solimplimit="0.99 0.999 0.001"/>
            <geom name="link_f_r_inner" type="capsule" fromto="0 0 0 0.02836 0 0" rgba="0.4 1 0.4 1"/>
            <site name="f_end_r" pos="0.02836 0 0" rgba="0.4 1 0.4 1"/>

            <body name="triangle_link2_r" pos="0.02836 0 0" euler="0 130 0">
            <joint name="tri_hinge_ghi_r" type="hinge" pos="0 0 0"/>
            <geom name="edge_g_r" type="capsule" fromto="0 0 0 0 0 0.05614" rgba="0 1 0 1"/>
            <geom name="edge_h_r" type="capsule" fromto="0 0 0 -0.0832629937 0 0.0586227155" rgba="0 1 0 1"/>
            <geom name="edge_i_r" type="capsule" fromto="0 0 0.05614 -0.0832629937 0 0.0586227155" rgba="0 1 0 1"/>
            <site name="g_i_r" pos="0 0 0.05614" rgba="0.5 1 0.5 1"/>
            </body>
          </body>
        </body>

        <site name="b_e_r" pos="0 0 0.06328" rgba="0.5 1 0.5 1"/>
      </body>

      <body name="link_m_y" pos="-0.055 0.05 0" childclass="leg_contact">
        <joint name="hinge_m_y" type="hinge" pos="0 0 0"/>
        <geom name="link_m_y" type="capsule" fromto="0 0 0 0.02384 0 0" rgba="0 0 1 1"/>
        <body name="link_j_y" pos="0.02384 0 0" euler="0 42 0">
          <joint name="hinge_j_y" type="hinge" pos="0 0 0"/>
          <geom name="link_j_y" type="capsule" fromto="0 0 0 -0.07870 0 0" rgba="0 0 1 1"/>
