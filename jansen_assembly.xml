                   solreflimit="0.00001 1" solimplimit="0.99 0.999 0.001"/>
            <geom name="link_f_y_inner" type="capsule" fromto="0 0 0 -0.02836 0 0" rgba="0.4 0.4 1 1"/>
            <site name="f_end_y" pos="-0.02836 0 0" rgba="0.4 0.4 1 1"/>
            <body name="triangle_link2_y" pos="-0.02836 0 0" euler="0 -130 0">
            <joint name="tri_hinge_ghi_y" type="hinge" pos="0 0 0"/>
            <geom name="edge_g_y" type="capsule" fromto="0 0 0 0 0 0.05614" rgba="0 0 1 1"/>
            <geom name="edge_h_y" type="capsule" fromto="0 0 0 0.0832629937 0 0.0586227155" rgba="0 0 1 1"/>
            <geom name="edge_i_y" type="capsule" fromto="0 0 0.05614 0.0832629937 0 0.0586227155" rgba="0 0 1 1"/>
            <site name="g_i_y" pos="0 0 0.05614" rgba="0.5 0.5 1 1"/>
            </body>
          </body>
        </body>
        <site name="b_e_y" pos="0 0 0.06328" rgba="0.5 0.5 1 1"/>
      </body>

      <body name="link_m_r_y" pos="0.055 0.05 0" childclass="leg_contact">
        <joint name="hinge_m_r_y" type="hinge" pos="0 0 0"/>
        <geom name="link_m_r_y" type="capsule" fromto="0 0 0 -0.02384 0 0" rgba="1 1 0 1"/>
        <body name="link_j_r_y" pos="-0.02384 0 0" euler="0 -42 0">
          <joint name="hinge_j_r_y" type="hinge" pos="0 0 0"/>
          <geom name="link_j_r_y" type="capsule" fromto="0 0 0 0.07870 0 0" rgba="1 1 0 1"/>
          <site name="j_end_r_y" pos="0.07870 0 0" rgba="1 1 0.4 1"/>
        </body>
        <body name="link_k_r_y" pos="-0.02384 0 0" euler="0 42 0">
