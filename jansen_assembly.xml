        <body name="link_k_y" pos="0.02384 0 0" euler="0 -42 0">
          <joint name="hinge_k_y" type="hinge" pos="0 0 0"/>
          <geom name="link_k_outer_y" type="capsule" fromto="0 0 0 -0.04180 0 0" rgba="0 0 1 1"/>
          <body name="link_k_inner_y" pos="-0.04180 0 0">
            <joint name="slide_k_y" type="slide" axis="-1 0 0" limited="true" range="-0.005 0.005" damping="100" armature="0.1"
                   solreflimit="0.00001 1" solimplimit="0.99 0.999 0.001"/>
            <geom name="link_k_inner_y" type="capsule" fromto="0 0 0 -0.04180 0 0" rgba="0.4 0.4 1 1"/>
            <site name="k_end_y" pos="-0.04180 0 0" rgba="0.5 0.5 1 1"/>
          </body>
        </body>
