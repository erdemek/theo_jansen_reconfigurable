<mujoco model="jansen_assembly">
  <compiler angle="degree"/>
  <!-- <option gravity="0 0 -9.81" timestep="0.001" integrator="implicitfast" iterations="120" tolerance="1e-10"/> -->
  <option gravity="0 0 -9.81"
          timestep="0.00025"
          integrator="implicitfast"
          solver="Newton"
          jacobian="dense"
          iterations="2000"
          ls_iterations="120"
          tolerance="1e-12"
          ls_tolerance="1e-14"
          cone="elliptic"
          noslip_iterations="40"
          noslip_tolerance="1e-10"/>
  <asset>
    <texture name="ground_tex" type="2d" builtin="checker" rgb1="0.22 0.26 0.30" rgb2="0.14 0.17 0.20" width="512" height="512"/>
    <material name="ground_mat" texture="ground_tex" texrepeat="24 24" reflectance="0"/>
  </asset>

  <default>
    <joint type="hinge" axis="0 1 0" damping="0.3" armature="0.003"/>
    <geom type="capsule" size="0.004" rgba="0.8 0.8 0.8 1" contype="0" conaffinity="0" density="1000"/>
    <site size="0.004"/>
    <default class="leg_contact">
      <geom contype="1" conaffinity="2" condim="3" friction="1 0.08 0.01"/>
    </default>
  </default>

  <worldbody>
    <geom name="ground" type="plane" pos="0 0 0" size="9 9 0.1" material="ground_mat" friction="1 0.08 0.01" contype="2" conaffinity="1"/>

    <!-- Plate dimensions: 0.25008 m x 0.1 m x 0.01 m -->
    <!-- MuJoCo box size uses half-extents: 0.12504 0.05 0.005 -->
    <!-- Center at z=0.155 so the plate bottom is at z=0.15 -->
    <body name="plate_body" pos="0 0 0.155">
      <freejoint name="plate_free"/>
      <geom
        name="plate"
        type="box"
        size="0.12504 0.05 0.005"
        rgba="0.75 0.75 0.82 1"
        density="5000"/>

      <body name="link_m" pos="-0.055 -0.05 0" childclass="leg_contact">
        <joint name="hinge_m" type="hinge" pos="0 0 0"/>
        <geom name="link_m" type="capsule" fromto="0 0 0 0.02384 0 0" rgba="1 0 0 1"/>
              <body name="link_j" pos="0.02384 0 0" euler="0 42 0">
                <joint name="hinge_j" type="hinge" pos="0 0 0"/>
                <geom name="link_j" type="capsule" fromto="0 0 0 -0.07870 0 0" rgba="1 0 0 1"/>              
                <site name="j_end" pos="-0.07870 0 0" rgba="1 0.4 0.4 1"/>          
              </body>
              <body name="link_k" pos="0.02384 0 0" euler="0 -42 0">
                <joint name="hinge_k" type="hinge" pos="0 0 0"/>
                <geom name="link_k_outer" type="capsule" fromto="0 0 0 -0.04180 0 0" rgba="1 0 0 1"/>
                <body name="link_k_inner" pos="-0.04180 0 0">
                  <joint name="slide_k" type="slide" axis="-1 0 0" limited="true" range="-0.005 0.005" damping="100" armature="0.1"
                         solreflimit="0.00001 1" solimplimit="0.99 0.999 0.001"/>
                  <geom name="link_k_inner" type="capsule" fromto="0 0 0 -0.04180 0 0" rgba="1 0.4 0.4 1"/>
                  <site name="k_end" pos="-0.04180 0 0" rgba="1 0.5 0.5 1"/>
                </body>
              </body>

      </body>
      <body name="link_c" pos="-0.11404 -0.05 0" euler="0 -110 0" childclass="leg_contact">
        <joint name="hinge_c" type="hinge" pos="0 0 0"/>
        <geom name="link_c" type="capsule" fromto="0 0 0 -0.06006 0 0" rgba="1 0 0 1"/>              
        <site name="c_end" pos="-0.06046 0 0" rgba="1 0.5 0.5 1"/>          
      </body>
      <body name="triangle_link1" pos="-0.11404 -0.05 0" euler="0 22 0" childclass="leg_contact">
        <joint name="tri_hinge" type="hinge" pos="0 0 0"/>

        <!-- Rigid triangle in one body: B(0,0,0), E(0,0,0.06328), D(-0.08869,0,0.00317) -->
        <geom name="edge_b" type="capsule" fromto="0 0 0 0 0 0.06328" rgba="1 0 0 1"/>
        <geom name="edge_e" type="capsule" fromto="0 0 0.06328 -0.0600779625 0 -0.0019622756" rgba="1 0 0 1"/>
        <geom name="edge_d" type="capsule" fromto="-0.0600779625 0 -0.0019622756 0 0 0" rgba="1 0 0 1"/>
              <body name="link_f_outer" pos="-0.0600779625 0 -0.0019622756" euler="0 -135 0">
                <joint name="hinge_f" type="hinge" pos="0 0 0"/>
                <geom name="link_f_outer" type="capsule" fromto="0 0 0 -0.02836 0 0" rgba="1 0 0 1"/>              
                <body name="link_f_inner" pos="-0.02836 0 0">
                    <joint name="slide_f" type="slide" axis="-1 0 0" limited="true" range="-0.005 0.005" damping="100" armature="0.1"
                           solreflimit="0.00001 1" solimplimit="0.99 0.999 0.001"/>
                    <geom name="link_f_inner" type="capsule" fromto="0 0 0 -0.02836 0 0" rgba="1 0.4 0.4 1"/>
                    <site name="f_end" pos="-0.02836 0 0" rgba="1 0.5 0.5 1"/>    
                    <body name="triangle_link2" pos="-0.02836 0 0" euler="0 -130 0">
                        <joint name="tri_hinge_ghi" type="hinge" pos="0 0 0"/>

                        <!-- Triangle where h-link is split into outer+inner with a prismatic joint -->
                        <geom name="edge_g" type="capsule" fromto="0 0 0 0 0 0.05614" rgba="1 0 0 1"/>
                        <geom name="edge_h_outer" type="capsule" fromto="0 0 0 0.0416314969 0 0.0293113578" rgba="1 0 0 1"/>
                        <body name="link_h_inner" pos="0.0416314969 0 0.0293113578">
                            <joint name="slide_h" type="slide" axis="0.8178 0 0.5755" limited="true" range="-0.005 0.005" damping="100" armature="0.1"
                                   solreflimit="0.00001 1" solimplimit="0.99 0.999 0.001"/>
                            <geom name="edge_h_inner" type="capsule" fromto="0 0 0 0.0416314969 0 0.0293113578" rgba="1 0.4 0.4 1"/>
                        </body>
                        <geom name="edge_i" type="capsule" fromto="0 0 0.05614 0.0832629937 0 0.0586227155" rgba="1 0 0 1"/>
                        <site name="g_i" pos="0 0 0.05614" rgba="1 0.5 0.5 1"/>
                    </body>                      
                </body>
              </body>        
              
        <site name="b_e" pos="0 0 0.06328" rgba="1 0.5 0.5 1"/>
      </body>



      <body name="link_m_r" pos="0.055 -0.05 0" childclass="leg_contact">
        <joint name="hinge_m_r" type="hinge" pos="0 0 0"/>
        <geom name="link_m_r" type="capsule" fromto="0 0 0 -0.02384 0 0" rgba="0 1 0 1"/>
        <body name="link_j_r" pos="-0.02384 0 0" euler="0 -42 0">
          <joint name="hinge_j_r" type="hinge" pos="0 0 0"/>
          <geom name="link_j_r" type="capsule" fromto="0 0 0 0.07870 0 0" rgba="0 1 0 1"/>
          <site name="j_end_r" pos="0.07870 0 0" rgba="0.4 1 0.4 1"/>
        </body>
        <body name="link_k_r" pos="-0.02384 0 0" euler="0 42 0">
          <joint name="hinge_k_r" type="hinge" pos="0 0 0"/>
          <geom name="link_k_outer_r" type="capsule" fromto="0 0 0 0.04180 0 0" rgba="0 1 0 1"/>
          <body name="link_k_inner_r" pos="0.04180 0 0">
            <joint name="slide_k_r" type="slide" axis="1 0 0" limited="true" range="-0.005 0.005" damping="100" armature="0.1"
                   solreflimit="0.00001 1" solimplimit="0.99 0.999 0.001"/>
            <geom name="link_k_inner_r" type="capsule" fromto="0 0 0 0.04180 0 0" rgba="0.4 1 0.4 1"/>
            <site name="k_end_r" pos="0.04180 0 0" rgba="0.5 1 0.5 1"/>
          </body>
        </body>
      </body>

      <body name="link_c_r" pos="0.11404 -0.05 0" euler="0 110 0" childclass="leg_contact">
        <joint name="hinge_c_r" type="hinge" pos="0 0 0"/>
        <geom name="link_c_r" type="capsule" fromto="0 0 0 0.06006 0 0" rgba="0 1 0 1"/>
