  <actuator>
    <velocity name="crank_motor" joint="hinge_m" kv="25" ctrllimited="true" ctrlrange="-80 80"/>
    <velocity name="crank_motor_r" joint="hinge_m_r" kv="25" ctrllimited="true" ctrlrange="-80 80"/>
    <velocity name="crank_motor_y" joint="hinge_m_y" kv="25" ctrllimited="true" ctrlrange="-80 80"/>
