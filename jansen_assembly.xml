<equality>
  <connect name="j_to_be" site1="b_e" site2="j_end" solref="0.02 1" solimp="0.99 0.999 0.001"/>
  <connect name="c_to_k" site1="c_end" site2="k_end" solref="0.02 1" solimp="0.99 0.999 0.001"/>
