        <geom name="link_c_y" type="capsule" fromto="0 0 0 -0.06006 0 0" rgba="0 0 1 1"/>
        <site name="c_end_y" pos="-0.06046 0 0" rgba="0.5 0.5 1 1"/>
      </body>

      <body name="triangle_link1_y" pos="-0.11404 0.05 0" euler="0 22 0" childclass="leg_contact">
        <joint name="tri_hinge_y" type="hinge" pos="0 0 0"/>
        <geom name="edge_b_y" type="capsule" fromto="0 0 0 0 0 0.06328" rgba="0 0 1 1"/>
        <geom name="edge_e_y" type="capsule" fromto="0 0 0.06328 -0.0600779625 0 -0.0019622756" rgba="0 0 1 1"/>
        <geom name="edge_d_y" type="capsule" fromto="-0.0600779625 0 -0.0019622756 0 0 0" rgba="0 0 1 1"/>
        <body name="link_f_y" pos="-0.0600779625 0 -0.0019622756" euler="0 -135 0">
          <joint name="hinge_f_y" type="hinge" pos="0 0 0"/>
          <geom name="link_f_y_outer" type="capsule" fromto="0 0 0 -0.02836 0 0" rgba="0 0 1 1"/>
          <body name="link_f_y_inner" pos="-0.02836 0 0">
